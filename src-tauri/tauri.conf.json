{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plex",
  "version": "0.1.0",
  "identifier": "com.plex.desktop",
  "build": {
    "beforeDevCommand": "bun run sidecar:build && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run sidecar:build && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Plex",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/plex-agent"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
